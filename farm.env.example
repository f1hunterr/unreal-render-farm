# Unreal Render Farm settings. Copy to farm.env (same folder) and fill in.
# Read by both the master and the agent at startup; real environment variables take precedence.
# deploy\install_service.ps1 restricts this file to Administrators, SYSTEM and the service user.

# --- Required on master AND every agent (same value everywhere, 16+ characters)
URF_FARM_TOKEN=change-me-to-a-long-random-secret

# --- Master only
URF_DASH_PASSWORD=change-me-dashboard-password
# URF_DASH_USER=admin
# URF_MASTER_DIR=C:\UnrealRenderFarm\master
# URF_MASTER_PORT=5000

# --- Agent only
# Folders .uproject files must be under (; separated). Needed for UNC paths.
URF_PROJECT_ROOTS=D:\Projects
# URF_UE_EXE=C:\Program Files\Epic Games\UE_5.6\Engine\Binaries\Win64\UnrealEditor-Cmd.exe
# URF_AGENT_LOG_DIR=C:\UnrealRenderFarm\agent\logs
# URF_AGENT_BIND=0.0.0.0
# URF_AGENT_PORT=5001
# Shared Derived Data Cache: a folder on the NAS every render PC can write to. Unreal builds a
# project's meshes/shaders once and every PC reuses them (otherwise each PC spends 10+ minutes per project).
# Prefer the dashboard's Admin -> Shared Cache Folder (used by every computer); this is only a fallback.
# URF_SHARED_DDC=\\192.168.1.20\RenderCache\FarmDDC
# Farm renders skip nDisplay's engine (1). Set 0 only for projects that really render through nDisplay.
# URF_SKIP_NDISPLAY=1
# Frozen-render watchdog, minutes (0 = off): no output while loading / no new frame while rendering
# URF_LOAD_STALL_MIN=30
# URF_RENDER_STALL_MIN=20
# Whole-project prepare (Epic's cache fill) may be quiet for a long time
# URF_FILL_STALL_MIN=120

# --- Both: rotating log file (10 MB x 5)
# URF_LOG_FILE=C:\UnrealRenderFarm\logs\farm.log
